<Window x:Class="DLM.helix.IfcRelatoriosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatorios e Graficos do Modelo IFC"
        Width="1120"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#1E293B">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Agrupamento Multi-Nivel -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nivel 1:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0" />
                <ComboBox x:Name="cbNivel1" Width="155" Height="26" Margin="0,0,12,0" SelectionChanged="Filtro_Changed" />

                <TextBlock Text="Nivel 2:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" />
                <ComboBox x:Name="cbNivel2" Width="155" Height="26" Margin="0,0,12,0" SelectionChanged="Filtro_Changed" />

                <TextBlock Text="Nivel 3:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" />
                <ComboBox x:Name="cbNivel3" Width="155" Height="26" Margin="0,0,12,0" SelectionChanged="Filtro_Changed" />

                <TextBlock Text="Grafico por:" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,5,0" />
                <ComboBox x:Name="cbMetrica" Width="140" Height="26" Margin="0,0,12,0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Quantidade" IsSelected="True" />
                    <ComboBoxItem Content="Peso (kg)" />
                    <ComboBoxItem Content="Comprimento (m)" />
                </ComboBox>

                <CheckBox x:Name="chkApenasVisiveis" Content="Apenas visiveis" VerticalAlignment="Center" Click="ChkVisiveis_Click" />
            </WrapPanel>
        </Border>

        <!-- Cards de Resumo -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL DE PECAS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="txtCardPecas" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0284C7" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="GRUPOS ENCONTRADOS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="txtCardGrupos" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="PESO TOTAL (kg)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="txtCardPeso" Text="0,0" FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="COMPRIMENTO TOTAL (m)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="txtCardComp" Text="0,0" FontSize="20" FontWeight="Bold" Foreground="#16A34A" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Graficos (Barras + Rosca) e Tabela -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="260" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Grafico de Barras -->
                <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TOP GRUPOS (BARRAS)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="canvasBarras" MinHeight="200" SizeChanged="Canvas_SizeChanged" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Grafico de Rosca (Donut) -->
                <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DISTRIBUICAO (%)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                        <Canvas x:Name="canvasRosca" Grid.Row="1" SizeChanged="Canvas_SizeChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Tabela Detalhada -->
            <DataGrid x:Name="dgRelatorio"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      RowHeight="25"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grupo / Niveis" Binding="{Binding ChaveGrupo}" Width="*" />
                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="75" />
                    <DataGridTextColumn Header="% Qtd" Binding="{Binding PercentualQuantidade, StringFormat={}{0:0.0}%}" Width="75" />
                    <DataGridTextColumn Header="Peso (kg)" Binding="{Binding PesoTotalKg, StringFormat={}{0:N2}}" Width="110" />
                    <DataGridTextColumn Header="% Peso" Binding="{Binding PercentualPeso, StringFormat={}{0:0.0}%}" Width="75" />
                    <DataGridTextColumn Header="Comp. (m)" Binding="{Binding ComprimentoTotalM, StringFormat={}{0:N2}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Rodape -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Selecionar Grupo no 3D" Click="BtnSelecionarNo3D_Click" Margin="0,0,8,0" Background="#E0F2FE" BorderBrush="#0284C7" Foreground="#0369A1" />
                <Button Content="Exportar CSV (Excel)..." Click="BtnExportarCsv_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Padding="18,5" />
        </DockPanel>
    </Grid>
</Window>
