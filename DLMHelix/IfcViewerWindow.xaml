<Window x:Class="DLM.helix.IfcViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        Title="Visualizador e Editor IFC / DWG - DLM"
        Width="1380"
        Height="860"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Foreground="#1E293B"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="BtnBarra" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDestaque" TargetType="Button" BasedOn="{StaticResource BtnBarra}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#0369A1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="TglBarra" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0369A1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SepBarra" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu Principal Organizado -->
        <Menu Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,2" Foreground="#1E293B" FontSize="12">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="Abrir IFC / DWG..." Click="BtnAbrir_Click" />
                <MenuItem Header="Juntar outro IFC / DWG (ponto interativo)..." Click="BtnJuntarIfc_Click" />
                <Separator />
                <MenuItem Header="Salvar IFC Completo..." Click="BtnSalvarIfc_Click" />
                <MenuItem Header="Exportar Selecao para IFC..." Click="BtnExportarIfcSelecao_Click" />
                <Separator />
                <MenuItem Header="Exportar DXF 3D (Tudo)..." Click="BtnExportarDxfTudo_Click" />
                <MenuItem Header="Exportar DXF 3D (Selecao)..." Click="BtnExportarDxfSelecao_Click" />
                <MenuItem Header="Exportar Vistas 2D pelos Eixos..." Click="BtnExportarVistas2D_Click" />
                <Separator />
                <MenuItem Header="Fechar" Click="MenuFechar_Click" />
            </MenuItem>

            <MenuItem Header="_Editar">
                <MenuItem Header="Mover Selecao / IFC Importado..." Click="BtnMover_Click" />
                <MenuItem Header="Adicionar Atributo nas Pecas..." Click="BtnAdicionarAtributo_Click" />
                <MenuItem Header="Agrupar Pecas por Propriedade..." Click="BtnAgrupar_Click" />
                <Separator />
                <MenuItem Header="Selecionar Mesmo Perfil" Click="MenuSelecionarMesmoPerfil_Click" />
                <MenuItem Header="Selecionar Mesmo Nivel/Grupo" Click="MenuSelecionarMesmoNivel_Click" />
                <MenuItem Header="Inverter Selecao" Click="MenuInverterSelecao_Click" />
            </MenuItem>

            <MenuItem Header="E_xibir">
                <MenuItem Header="Enquadrar Tudo" Click="BtnZoomExtents_Click" />
                <MenuItem Header="Enquadrar Selecao" Click="MenuEnquadrarSelecao_Click" />
                <Separator />
                <MenuItem Header="Vista Isometrica" Click="BtnVistaIso_Click" />
                <MenuItem Header="Vista Frontal" Click="BtnVistaFrontal_Click" />
                <MenuItem Header="Vista Posterior" Click="BtnVistaPosterior_Click" />
                <MenuItem Header="Vista Superior" Click="BtnVistaSuperior_Click" />
                <MenuItem Header="Vista Inferior" Click="BtnVistaInferior_Click" />
                <MenuItem Header="Vista Esquerda" Click="BtnVistaEsquerda_Click" />
                <MenuItem Header="Vista Direita" Click="BtnVistaDireita_Click" />
                <Separator />
                <MenuItem Header="Isolar Selecao" Click="BtnIsolar_Click" />
                <MenuItem Header="Ocultar Selecao" Click="BtnOcultar_Click" />
                <MenuItem Header="Mostrar Tudo" Click="BtnMostrarTudo_Click" />
            </MenuItem>

            <MenuItem Header="Ei_xos e Grid">
                <MenuItem Header="Lista / Editar Eixos..." Click="BtnGerenciarGrid_Click" />
                <MenuItem Header="Remapear Eixos do Modelo 3D" Click="MenuRemapearEixos_Click" />
                <Separator />
                <MenuItem Header="Exportar Vistas 2D pelos Eixos..." Click="BtnExportarVistas2D_Click" />
                <MenuItem Header="Quebrar IFC pelos Eixos..." Click="BtnQuebrarPorEixos_Click" />
            </MenuItem>

            <MenuItem Header="_Ferramentas">
                <MenuItem Header="Medir Distancia 3D (2 Pontos)" Click="BtnMedir_Click" />
                <MenuItem Header="Configurar Snaps (Endpoint / Midpoint / Nearest)..." Click="BtnConfigSnaps_Click" />
                <Separator />
                <MenuItem Header="Aplicar Cores Padrao no Modelo (Viga=Vermelho, Purlin=Amarelo...)" Click="MenuAplicarCoresPadrao_Click" />
                <MenuItem Header="Opcoes e Configuracoes (Cores, De-Para, Grid, 3D)..." Click="BtnConfig_Click" />
            </MenuItem>
        </Menu>

        <!-- Barra de Ferramentas Visual com Icones Vetoriais Nitidos -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Arquivo -->
                <Button Style="{StaticResource BtnDestaque}" Click="BtnAbrir_Click" ToolTip="Abrir arquivo IFC ou DWG">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" Stroke="White" StrokeThickness="1.6" Data="M1,3 L5,3 L6.5,5 L13,5 L13,12 L1,12 Z" />
                        <TextBlock Text="Abrir" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnSalvarIfc_Click" ToolTip="Salvar modelo completo em IFC">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" Stroke="#1E293B" StrokeThickness="1.5" Data="M2,1 L10,1 L13,4 L13,13 L2,13 Z M4,1 L4,5 L9,5 L9,1 M4,13 L4,8 L11,8 L11,13" />
                        <TextBlock Text="Salvar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnJuntarIfc_Click" ToolTip="Juntar outro IFC/DWG escolhendo ponto interativo no 3D">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" Stroke="#0284C7" StrokeThickness="1.7" Data="M7,2 L7,12 M2,7 L12,7" />
                        <TextBlock Text="Juntar IFC" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource SepBarra}" />

                <!-- Vistas -->
                <Button Style="{StaticResource BtnBarra}" Click="BtnZoomExtents_Click" ToolTip="Enquadrar Tudo (Zoom Extents)">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="#1E293B" StrokeThickness="1.6" Data="M2,5 L2,2 L5,2 M9,2 L12,2 L12,5 M12,9 L12,12 L9,12 M5,12 L2,12 L2,9" />
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnVistaIso_Click" ToolTip="Vista Isometrica">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="#1E293B" StrokeThickness="1.5" Data="M7,1.5 L12.5,4.5 L12.5,10.5 L7,13.5 L1.5,10.5 L1.5,4.5 Z M1.5,4.5 L7,7.5 L12.5,4.5 M7,7.5 L7,13.5" />
                </Button>
                <Button Style="{StaticResource BtnBarra}" Content="F" Width="28" Padding="0" Click="BtnVistaFrontal_Click" ToolTip="Vista Frontal" />
                <Button Style="{StaticResource BtnBarra}" Content="S" Width="28" Padding="0" Click="BtnVistaSuperior_Click" ToolTip="Vista Superior" />
                <Button Style="{StaticResource BtnBarra}" Content="L" Width="28" Padding="0" Click="BtnVistaEsquerda_Click" ToolTip="Vista Lateral Esquerda" />

                <Border Style="{StaticResource SepBarra}" />

                <!-- Visualizacao -->
                <ToggleButton x:Name="tglArestas" Style="{StaticResource TglBarra}" Content="Arestas" IsChecked="True" Click="TglArestas_Click" ToolTip="Mostrar/Ocultar arestas" />
                <ToggleButton x:Name="tglPerspectiva" Style="{StaticResource TglBarra}" Content="3D Persp" IsChecked="False" Click="TglPerspectiva_Click" ToolTip="Alternar camera Ortografica / Perspectiva" />
                <ToggleButton x:Name="tglRaioX" Style="{StaticResource TglBarra}" Content="Raio-X" IsChecked="False" Click="TglRaioX_Click" ToolTip="Modo Raio-X / Fantasma" />
                <ToggleButton x:Name="tglCorte" Style="{StaticResource TglBarra}" Content="Corte" IsChecked="False" Click="TglCorte_Click" ToolTip="Plano de Corte (Cut Plane X, Y, Z)" />
                <ToggleButton x:Name="tglGrid" Style="{StaticResource TglBarra}" Content="Grid" IsChecked="True" Click="TglGrid_Click" ToolTip="Mostrar/Ocultar Grid de eixos" />

                <Border Style="{StaticResource SepBarra}" />

                <!-- Edicao & Medicao -->
                <Button Style="{StaticResource BtnBarra}" Click="BtnMover_Click" ToolTip="Mover selecao, IFC importado ou modelo todo">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#1E293B" StrokeThickness="1.5" Data="M7,1 L7,13 M1,7 L13,7 M5,3 L7,1 L9,3 M5,11 L7,13 L9,11 M3,5 L1,7 L3,9 M11,5 L13,7 L11,9" />
                        <TextBlock Text="Mover" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnAdicionarAtributo_Click" ToolTip="Inserir atributo na selecao, no IFC importado ou em tudo">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#1E293B" StrokeThickness="1.5" Data="M2,2 L8,2 L13,7 L7,13 L2,8 Z M5,5 L5.5,5.5" />
                        <TextBlock Text="+Atributo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnAgrupar_Click" ToolTip="Agrupar pecas por propriedade em comum criando novo nivel na arvore">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#1E293B" StrokeThickness="1.5" Data="M2,2 L6,2 L6,6 L2,6 Z M8,2 L12,2 L12,6 L8,6 Z M8,8 L12,8 L12,12 L8,12 Z M4,6 L4,10 L8,10" />
                        <TextBlock Text="Agrupar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnMedir_Click" ToolTip="Medir distancia 3D entre 2 pontos">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#DC2626" StrokeThickness="1.6" Data="M2,11 L11,2 M2,11 L5,11 M2,11 L2,8 M11,2 L8,2 M11,2 L11,5" />
                        <TextBlock Text="Medir" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource SepBarra}" />

                <!-- Eixos, Quebra e Vistas 2D -->
                <Button Style="{StaticResource BtnBarra}" Click="BtnGerenciarGrid_Click" ToolTip="Lista de Eixos (editar nomes, distancias, adicionar/remover, Remapear Eixos)">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#0284C7" StrokeThickness="1.5" Data="M4,1 L4,13 M10,1 L10,13 M1,4 L13,4 M1,10 L13,10" />
                        <TextBlock Text="Eixos" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnExportarVistas2D_Click" ToolTip="Exportar vistas 2D (DXF) pelos eixos escolhidos com profundidade">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#0284C7" StrokeThickness="1.5" Data="M2,2 L12,2 L12,12 L2,12 Z M2,6 L12,6 M6,6 L6,12" />
                        <TextBlock Text="Vistas 2D" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="BtnQuebrarPorEixos_Click" ToolTip="Quebrar IFC em arquivos separados pelos eixos">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#1E293B" StrokeThickness="1.5" Data="M2,2 L6,2 L6,12 L2,12 Z M8,2 L12,2 L12,12 L8,12 Z" />
                        <TextBlock Text="Quebrar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource SepBarra}" />

                <!-- Opcoes -->
                <Button Style="{StaticResource BtnBarra}" Click="BtnConfig_Click" ToolTip="Tela de Opcoes completa (Cores, De-Para, Grid, 3D, Vistas 2D)">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" Stroke="#475569" StrokeThickness="1.5" Data="M7,4.5 A2.5,2.5 0 1 0 7,9.5 A2.5,2.5 0 1 0 7,4.5 M7,1 L7,3 M7,11 L7,13 M1,7 L3,7 M11,7 L13,7 M2.8,2.8 L4.2,4.2 M9.8,9.8 L11.2,11.2 M11.2,2.8 L9.8,4.2 M4.2,9.8 L2.8,11.2" />
                        <TextBlock Text="Opcoes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Banner Interativo (Modo Juntar IFC / Modo Mover / Modo Medir) -->
        <StackPanel Grid.Row="2">
            <Border x:Name="pnlModoInterativo" Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="txtInstrucaoInterativa"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#0C4A6E"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Text="Clique no ponto 3D desejado..." />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="X(mm):" VerticalAlignment="Center" Margin="8,0,3,0" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="txtPontoX" Width="68" Height="24" VerticalContentAlignment="Center" Background="White" Foreground="#0F172A" BorderBrush="#0284C7" Text="0" />
                        <TextBlock Text="Y(mm):" VerticalAlignment="Center" Margin="6,0,3,0" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="txtPontoY" Width="68" Height="24" VerticalContentAlignment="Center" Background="White" Foreground="#0F172A" BorderBrush="#0284C7" Text="0" />
                        <TextBlock Text="Z(mm):" VerticalAlignment="Center" Margin="6,0,3,0" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="txtPontoZ" Width="68" Height="24" VerticalContentAlignment="Center" Background="White" Foreground="#0F172A" BorderBrush="#0284C7" Text="0" />
                        <Button Style="{StaticResource BtnDestaque}" Height="24" Margin="8,0,0,0" Content="Aplicar Ponto" Click="BtnAplicarPontoManual_Click" />
                        <Button Style="{StaticResource BtnBarra}" Height="24" Margin="4,0,0,0" Content="Snaps..." Click="BtnConfigSnaps_Click" ToolTip="Habilitar/Desabilitar snaps Endpoint, Midpoint e Nearest" />
                        <Button Style="{StaticResource BtnBarra}" Height="24" Margin="4,0,0,0" Content="Cancelar (ESC)" Click="BtnCancelarModoInterativo_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barra de Plano de Corte (Cut Plane / Section Box estilo xBimXplorer) -->
            <Border x:Name="pnlPlanoCorte" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,5" Visibility="Collapsed">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PLANO DE CORTE:" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                    <CheckBox x:Name="chkCorteX" Content="Corte X" VerticalAlignment="Center" Margin="0,0,4,0" Click="Corte_Changed" />
                    <Slider x:Name="sldCorteX" Width="130" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,0,14,0" ValueChanged="SldCorte_ValueChanged" />

                    <CheckBox x:Name="chkCorteY" Content="Corte Y" VerticalAlignment="Center" Margin="0,0,4,0" Click="Corte_Changed" />
                    <Slider x:Name="sldCorteY" Width="130" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,0,14,0" ValueChanged="SldCorte_ValueChanged" />

                    <CheckBox x:Name="chkCorteZ" Content="Corte Z" VerticalAlignment="Center" Margin="0,0,4,0" Click="Corte_Changed" />
                    <Slider x:Name="sldCorteZ" Width="130" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,0,14,0" ValueChanged="SldCorte_ValueChanged" />

                    <Button Style="{StaticResource BtnBarra}" Height="24" Content="Resetar Cortes" Click="BtnResetarCortes_Click" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Area Principal: Arvore | Viewport 3D | Propriedades -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo: Arvore de Selecao -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="ARVORE DE SELECAO" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                    </Border>

                    <Grid Grid.Row="1" Margin="6">
                        <TextBox x:Name="txtFiltroArvore"
                                 Height="26"
                                 Background="#F8FAFC"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Filtrar pecas ou grupos na arvore"
                                 TextChanged="TxtFiltroArvore_TextChanged" />
                    </Grid>

                    <TreeView x:Name="tvArvore"
                              Grid.Row="2"
                              Background="#FFFFFF"
                              Foreground="#1E293B"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="TvArvore_SelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Enquadrar Selecao" Click="MenuEnquadrarSelecao_Click" />
                                <MenuItem Header="Isolar Selecao" Click="BtnIsolar_Click" />
                                <MenuItem Header="Ocultar Selecao" Click="BtnOcultar_Click" />
                                <MenuItem Header="Mostrar Tudo" Click="BtnMostrarTudo_Click" />
                                <Separator />
                                <MenuItem Header="Mover Selecao..." Click="BtnMover_Click" />
                                <MenuItem Header="Adicionar Atributo na Selecao..." Click="BtnAdicionarAtributo_Click" />
                                <Separator />
                                <MenuItem Header="Exportar Selecao para IFC..." Click="BtnExportarIfcSelecao_Click" />
                                <MenuItem Header="Exportar Selecao para DXF 3D..." Click="BtnExportarDxfSelecao_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="6">
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource BtnBarra}" Height="24" FontSize="10.5" Content="Isolar" Click="BtnIsolar_Click" />
                            <Button Style="{StaticResource BtnBarra}" Height="24" FontSize="10.5" Content="Ocultar" Click="BtnOcultar_Click" />
                            <Button Style="{StaticResource BtnBarra}" Height="24" FontSize="10.5" Content="Mostrar Tudo" Click="BtnMostrarTudo_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E2E8F0" />

            <!-- Centro: Viewport 3D Claro e Bem Iluminado + Canvas de Caixa de Selecao -->
            <Grid Grid.Column="2" x:Name="gridViewport">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EFF4F9" Offset="0" />
                        <GradientStop Color="#D7E1EC" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <h:HelixViewport3D x:Name="vp3D"
                                   Background="Transparent"
                                   IsHeadLightEnabled="True"
                                   ShowCoordinateSystem="True"
                                   ShowViewCube="True"
                                   ZoomExtentsWhenLoaded="True"
                                   ZoomAroundMouseDownPoint="True"
                                   RotateAroundMouseDownPoint="True"
                                   PreviewMouseLeftButtonDown="Vp3D_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="Vp3D_PreviewMouseMove"
                                   PreviewMouseLeftButtonUp="Vp3D_PreviewMouseLeftButtonUp"
                                   PreviewMouseRightButtonDown="Vp3D_PreviewMouseRightButtonDown"
                                   PreviewMouseRightButtonUp="Vp3D_PreviewMouseRightButtonUp">
                    <h:SunLight Brightness="0.9" />
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#969696" />
                                <DirectionalLight Color="#B0B0B0" Direction="1,-1,-1.2" />
                                <DirectionalLight Color="#787878" Direction="-1,1,-0.6" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <h:HelixViewport3D.Camera>
                        <OrthographicCamera NearPlaneDistance="-10000" FarPlaneDistance="10000" Width="10" />
                    </h:HelixViewport3D.Camera>
                </h:HelixViewport3D>

                <!-- Canvas Overlay para Caixa de Selecao (Marquee) e Indicador Visual de Snap -->
                <Canvas x:Name="canvasSelecao" IsHitTestVisible="False">
                    <Rectangle x:Name="rectSelecao"
                               Visibility="Collapsed"
                               StrokeThickness="1.5"
                               Stroke="#2563EB"
                               Fill="#333B82F6" />
                    <Border x:Name="marcadorSnap"
                            Visibility="Collapsed"
                            Width="12"
                            Height="12"
                            BorderThickness="2"
                            BorderBrush="#16A34A"
                            Background="#3316A34A" />
                    <Border x:Name="tagSnap"
                            Visibility="Collapsed"
                            Background="#E60F172A"
                            CornerRadius="3"
                            Padding="5,2">
                        <TextBlock x:Name="txtTagSnap" Foreground="White" FontSize="10.5" FontWeight="Bold" Text="END" />
                    </Border>
                </Canvas>

                <!-- Overlay de Carregamento -->
                <Border x:Name="pnlCarregando"
                        Background="#B8F1F5F9"
                        Visibility="Collapsed">
                    <Border Background="#FFFFFF"
                            BorderBrush="#0284C7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="320">
                        <StackPanel>
                            <TextBlock x:Name="txtCarregando" Text="Carregando modelo..." Foreground="#0F172A" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                            <ProgressBar x:Name="pbCarregando" Height="10" Minimum="0" Maximum="100" Foreground="#0284C7" Background="#E2E8F0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#E2E8F0" />

            <!-- Painel Direito: Propriedades -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="PROPRIEDADES" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnBarra}" Height="22" Padding="7,0" FontSize="10.5" Content="+ Atributo" Click="BtnAdicionarAtributo_Click" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock x:Name="txtResumoSelecao"
                                   Text="Nenhum elemento selecionado."
                                   Foreground="#334155"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                    </Border>

                    <DataGrid x:Name="dgPropriedades"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#FFFFFF"
                              Foreground="#0F172A"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8FAFC"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              FontSize="11.5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aba" Binding="{Binding Aba}" Width="70" />
                            <DataGridTextColumn Header="Propriedade" Binding="{Binding Nome}" Width="110" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Status -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" Text="Pronto. Arraste com o botao esquerdo para caixa de selecao (Azul=Window, Verde=Crossing); Botao direito abre menu." Foreground="#475569" FontSize="11.5" />
                <TextBlock x:Name="txtContadores" DockPanel.Dock="Right" Text="" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
