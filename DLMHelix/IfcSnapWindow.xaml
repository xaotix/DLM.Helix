<Window x:Class="DLM.helix.IfcSnapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Snaps (Medicao e Pontos 3D)"
        Width="400"
        SizeToContent="Height"
        MinHeight="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#1E293B">
        <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Habilite ou desabilite os snaps ativos ao medir ou escolher pontos no 3D:"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Path Width="14" Height="14" Stretch="None" Stroke="#16A34A" StrokeThickness="2" Fill="#3316A34A" Data="M1,1 L13,1 L13,13 L1,13 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                <CheckBox x:Name="chkEndpoint" Content="Endpoint (Extremidades e vertices de arestas)" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Path Width="14" Height="14" Stretch="None" Stroke="#0284C7" StrokeThickness="2" Fill="#330284C7" Data="M7,1 L13,13 L1,13 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                <CheckBox x:Name="chkMidpoint" Content="Midpoint (Ponto medio de arestas)" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Path Width="14" Height="14" Stretch="None" Stroke="#EA580C" StrokeThickness="2" Fill="#33EA580C" Data="M1,1 L13,1 L7,7 Z M7,7 L13,13 L1,13 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                <CheckBox x:Name="chkNearest" Content="Nearest (Ponto mais proximo na aresta / face)" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Raio de captura (pixels):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="txtRaio" Width="60" Height="24" VerticalContentAlignment="Center" Padding="4,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aplicar" Click="BtnAplicar_Click" IsDefault="True" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="14,5" Margin="0,0,8,0" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>

