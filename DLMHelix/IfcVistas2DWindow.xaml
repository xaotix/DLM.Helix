<Window x:Class="DLM.helix.IfcVistas2DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Vistas 2D pelos Eixos"
        Width="740"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#1E293B">
        <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho / Acoes de Eixos -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="Selecione os eixos para gerar as vistas 2D (DXF):"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Marcar Todos" Click="BtnMarcarTodos_Click" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Desmarcar" Click="BtnDesmarcarTodos_Click" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Remapear / Editar Eixos..." Click="BtnEditarEixos_Click" Padding="10,4" Background="#E0F2FE" BorderBrush="#0284C7" Foreground="#0369A1" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lista de Eixos (editavel e selecionavel) -->
        <DataGrid x:Name="dgEixos"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  RowHeight="26"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Exportar" Binding="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                <DataGridTextColumn Header="Direcao" Binding="{Binding Direcao}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="Nome do Eixo" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                <DataGridTextColumn Header="Coordenada (mm)" Binding="{Binding CoordenadaMm, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                <DataGridTextColumn Header="Plano da Vista 2D" Binding="{Binding DescricaoPlano}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Configuracao de Profundidade e Opcoes DXF 2D -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="Profundidade de corte (a partir do centro do eixo para fora, perpendicular ao eixo):" FontWeight="Bold" Margin="0,0,0,6" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Para tras (-) mm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="txtProfAtras" Width="80" Height="24" Text="500" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,16,0" />
                    <TextBlock Text="Para frente (+) mm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="txtProfFrente" Width="80" Height="24" Text="500" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,16,0" />
                    <TextBlock Text="Prefixo arquivo:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="txtPrefixo" Width="130" Height="24" Text="" VerticalContentAlignment="Center" Padding="4,0" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkEixosCruzados" Content="Incluir eixos cruzados e bolhas" IsChecked="True" Margin="0,0,14,4" />
                    <CheckBox x:Name="chkCotas" Content="Incluir cotas entre eixos" IsChecked="True" Margin="0,0,14,4" />
                    <CheckBox x:Name="chkFuros" Content="Incluir furos e recortes" IsChecked="True" Margin="0,0,14,4" />
                    <CheckBox x:Name="chkIndividuais" Content="1 arquivo DXF por eixo" IsChecked="True" Margin="0,0,14,4" />
                    <CheckBox x:Name="chkUnico" Content="Tambem gerar 1 DXF unico com todas as vistas" IsChecked="True" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Rodape -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="txtResumo" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B" FontSize="11.5" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Escolher Pasta e Exportar Vistas 2D..." Click="BtnExportar_Click" IsDefault="True" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="16,6" Margin="0,0,8,0" BorderThickness="0" />
                <Button Content="Fechar" IsCancel="True" Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

