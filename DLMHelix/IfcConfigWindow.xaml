<Window x:Class="DLM.helix.IfcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opcoes e Configuracoes - Visualizador e Motor IFC"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#1E293B">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White" BorderBrush="#CBD5E1">
            <!-- Aba 1: Opcoes Gerais (Visualizacao 3D, Grid/Eixos, Vistas 2D, Exportacao IFC) -->
            <TabItem Header="Geral / 3D / Grid / Vistas 2D">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Grupo: Grid / Eixos -->
                        <GroupBox Header="Grid e Eixos Estruturais" Margin="0,0,0,10" Padding="8" BorderBrush="#CBD5E1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tolerancia minima entre eixos (mm):" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="txtTolEixos" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Nao cria 2 eixos se a distancia for &lt;= tolerancia (padrao 500 mm)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerancia Z para eixos (mm):" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="txtTolZEixos" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Range em torno de Z=0 (±valor/2; ex: 1000 = -500 a +500 mm)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Folga / extensao das linhas (mm):" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="txtFolgaGrid" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />

                                <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                    <CheckBox x:Name="chkMostrarGridPadrao" Content="Mostrar Grid automaticamente ao abrir modelo" Margin="0,0,18,0" />
                                    <CheckBox x:Name="chkExportarGridPadrao" Content="Exportar Grid (IfcGrid) junto com o IFC por padrao" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Grupo: Visualizacao 3D -->
                        <GroupBox Header="Visualizacao 3D" Margin="0,0,0,10" Padding="8" BorderBrush="#CBD5E1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Espessura arestas principais:" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="txtEspArestas" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Espessura furos/recortes:" VerticalAlignment="Center" Margin="14,3,0,3" />
                                <TextBox x:Name="txtEspFuros" Grid.Row="0" Grid.Column="3" Width="90" HorizontalAlignment="Left" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cor fundo viewport (Topo / Base):" VerticalAlignment="Center" Margin="0,3" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,3">
                                    <Button x:Name="btnCorFundoTopo" Width="70" Height="24" Content="Topo" Click="BtnCorFundoTopo_Click" Margin="0,0,6,0" BorderBrush="#64748B" />
                                    <TextBox x:Name="txtCorFundoTopo" Width="80" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,16,0" />
                                    <Button x:Name="btnCorFundoBase" Width="70" Height="24" Content="Base" Click="BtnCorFundoBase_Click" Margin="0,0,6,0" BorderBrush="#64748B" />
                                    <TextBox x:Name="txtCorFundoBase" Width="80" Height="24" VerticalContentAlignment="Center" Padding="4,0" />
                                </StackPanel>

                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                    <CheckBox x:Name="chkMostrarArestasPadrao" Content="Mostrar arestas por padrao" Margin="0,0,16,0" />
                                    <CheckBox x:Name="chkPerspectivaPadrao" Content="Abrir em camera Perspectiva" Margin="0,0,16,0" />
                                    <CheckBox x:Name="chkUsarSpecular" Content="Iluminacao especular (brilho metalico)" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Grupo: Vistas 2D -->
                        <GroupBox Header="Exportacao de Vistas 2D (DXF)" Margin="0,0,0,10" Padding="8" BorderBrush="#CBD5E1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Profundidade padrao atras (-) mm:" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="txtProfAtras" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Profundidade frente (+) mm:" VerticalAlignment="Center" Margin="14,3,0,3" />
                                <TextBox x:Name="txtProfFrente" Grid.Row="0" Grid.Column="3" Width="90" HorizontalAlignment="Left" Height="24" VerticalContentAlignment="Center" Padding="4,0" Margin="0,3" />

                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                    <CheckBox x:Name="chkV2DEixos" Content="Incluir eixos cruzados e bolhas" Margin="0,0,16,0" />
                                    <CheckBox x:Name="chkV2DCotas" Content="Incluir cotas entre eixos" Margin="0,0,16,0" />
                                    <CheckBox x:Name="chkV2DFuros" Content="Incluir furos e recortes" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Grupo: Exportacao IFC -->
                        <GroupBox Header="Exportacao IFC (Elementos e Cores)" Padding="8" BorderBrush="#CBD5E1">
                            <StackPanel>
                                <CheckBox x:Name="chkUsarCoresDwg"
                                          Content="Usar cores setadas no DWG ao converter TecnoMetal para IFC (desmarcado = usar cores padrao por categoria)"
                                          FontWeight="SemiBold"
                                          Foreground="#0369A1"
                                          Margin="0,0,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="chkExpChapas" Content="Chapas" Margin="0,0,18,0" />
                                    <CheckBox x:Name="chkExpPerfis" Content="Perfis" Margin="0,0,18,0" />
                                    <CheckBox x:Name="chkExpFuros" Content="Furos e Recortes" Margin="0,0,18,0" />
                                    <CheckBox x:Name="chkExpParafusos" Content="Parafusos, Porcas e Arruelas" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Aba 2: Cores -->
            <TabItem Header="Cores das Pecas">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Clique no quadrado de cor ou edite o codigo Hex (#RRGGBB) para personalizar as cores de exportacao IFC."
                               Foreground="#475569"
                               Margin="0,0,0,8" />

                    <DataGrid x:Name="dgCores"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeight="28"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="#CBD5E1"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoria / Tipo" Binding="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                            <DataGridTemplateColumn Header="Cor" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnEscolherCor_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Margin="6,2"
                                                BorderBrush="#64748B"
                                                BorderThickness="1"
                                                Background="{Binding BrushCor}"
                                                ToolTip="Clique para escolher a cor" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Codigo Hex (#RRGGBB)" Binding="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTemplateColumn Header="Acao" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Click="BtnRemoverCor_Click" Tag="{Binding}" Margin="4,2" Padding="6,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Nova Categoria" Click="BtnAdicionarCor_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Restaurar Tudo Padrao" Click="BtnRestaurarPadrao_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Aba 3: De-Para de Propriedades -->
            <TabItem Header="De-Para de Propriedades">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Nome da Aba (PropertySet) no IFC:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox x:Name="txtNomeAba" Width="180" Height="26" VerticalContentAlignment="Center" Padding="6,0" />
                            <CheckBox x:Name="chkExportarNaoMapeadas"
                                      Content="Exportar propriedades nao listadas abaixo com o nome original"
                                      VerticalAlignment="Center"
                                      Margin="18,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Defina o De -> Para dos nomes de saida. Deixe a coluna 'Nome na Saida (Para)' vazia para omitir a propriedade."
                                   Foreground="#475569"
                                   FontSize="11.5" />
                    </StackPanel>

                    <DataGrid x:Name="dgDePara"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="#CBD5E1"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Propriedade Interna (De)" Binding="{Binding De, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Nome na Saida IFC (Para)" Binding="{Binding Para, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Header="Acao" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Click="BtnRemoverDePara_Click" Tag="{Binding}" Margin="4,2" Padding="6,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Adicionar Mapeamento" Click="BtnAdicionarDePara_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Aba 4: Propriedades Fixas -->
            <TabItem Header="Propriedades Fixas Globais">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Propriedades adicionadas automaticamente a TODAS as pecas exportadas no IFC (ex: Obra, Cliente, Revisao)."
                               Foreground="#475569"
                               Margin="0,0,0,8" />

                    <DataGrid x:Name="dgFixas"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="#CBD5E1"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome da Propriedade" Binding="{Binding De, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Valor Fixo" Binding="{Binding Para, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Header="Acao" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Click="BtnRemoverFixa_Click" Tag="{Binding}" Margin="4,2" Padding="6,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Adicionar Propriedade Fixa" Click="BtnAdicionarFixa_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Rodape -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="txtCaminhoCfg" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salvar e Aplicar" Click="BtnSalvar_Click" IsDefault="True" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="16,6" Margin="0,0,8,0" BorderThickness="0" />
                <Button Content="Cancelar" IsCancel="True" Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
