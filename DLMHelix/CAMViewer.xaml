<UserControl x:Class="DLM.helix.CAMViewer"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
			 mc:Ignorable="d"
			 xmlns:local="clr-namespace:DLM.helix"
			 d:DesignHeight="450"
             Loaded="CAMViewer_Loaded"
			 d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Estilo compacto e isolado para a barra do visualizador (sem conflito com Button global) -->
        <Style x:Key="BotaoViewer3D" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="#D9232F3E" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleViewer3D" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="#D9232F3E" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0EA5E9" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7DD3FC" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid x:Name="grid_vista_3d" Background="Transparent">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EFF4F9" Offset="0" />
                            <GradientStop Color="#D7E1EC" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <h:HelixViewport3D SizeChanged="viewport_SizeChanged"
									   ZoomExtentsWhenLoaded="True"
									   Name="viewPort3D"
									   ShowCoordinateSystem="False"
									   IsTouchZoomEnabled="True"
									   Background="Transparent"
									   IsHeadLightEnabled="True"
									   ZoomAroundMouseDownPoint="True"
									   RotateAroundMouseDownPoint="True">
                        <h:SunLight Brightness="0.9" />
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#969696" />
                                    <DirectionalLight Color="#B0B0B0" Direction="1,-1,-1.2" />
                                    <DirectionalLight Color="#787878" Direction="-1,1,-0.6" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <h:HelixViewport3D.Camera>
                            <OrthographicCamera NearPlaneDistance="-10000" FarPlaneDistance="10000" Width="10" />
                        </h:HelixViewport3D.Camera>
                    </h:HelixViewport3D>

                    <!-- Menu expansível no canto inferior esquerdo com ferramentas 3D -->
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,8"
                            Padding="4,2"
                            CornerRadius="4"
                            Background="#D9111827"
                            BorderBrush="#334155"
                            BorderThickness="1">
                        <Expander x:Name="exp_ferramentas_3d"
                                  IsExpanded="True"
                                  Foreground="#FFFFFF"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0">
                            <Expander.Header>
                                <TextBlock Text="Ferramentas" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Expander.Header>
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <Button x:Name="bt_tela_cheia_3d" Style="{StaticResource BotaoViewer3D}" Click="abrir_tela_cheia_click" ToolTip="Abrir em janela maximizada">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Data="M2,2 L12,2 L12,12 L2,12 Z M2,4.5 L12,4.5" />
                                </Button>
                                <Button Style="{StaticResource BotaoViewer3D}" Click="zom_ex" ToolTip="Enquadrar (Zoom Extents)">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M2,5 L2,2 L5,2 M9,2 L12,2 L12,5 M12,9 L12,12 L9,12 M5,12 L2,12 L2,9" />
                                </Button>

                                <Border Width="1" Background="#334155" Margin="4,3" />
                                <TextBlock Text="View:" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
                                <Button Style="{StaticResource BotaoViewer3D}" Click="iso" ToolTip="Isométrica">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Data="M7,1.5 L12.5,4.5 L12.5,10.5 L7,13.5 L1.5,10.5 L1.5,4.5 Z M1.5,4.5 L7,7.5 L12.5,4.5 M7,7.5 L7,13.5" />
                                </Button>
                                <Button Style="{StaticResource BotaoViewer3D}" Click="top_click" ToolTip="Top (Superior)">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Data="M2,3 L12,3 L12,11 L2,11 Z M2,6 L12,6" />
                                </Button>
                                <Button Style="{StaticResource BotaoViewer3D}" Click="bottom_click" ToolTip="Bottom (Inferior)">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Data="M2,3 L12,3 L12,11 L2,11 Z M2,8 L12,8" />
                                </Button>
                                <Button Style="{StaticResource BotaoViewer3D}" Click="left_click" ToolTip="Left (Esquerda)">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Data="M2,2 L12,2 L12,12 L2,12 Z M5,2 L5,12" />
                                </Button>
                                <Button Style="{StaticResource BotaoViewer3D}" Click="right_click" ToolTip="Right (Direita)">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Data="M2,2 L12,2 L12,12 L2,12 Z M9,2 L9,12" />
                                </Button>

                                <Border Width="1" Background="#334155" Margin="4,3" />

                                <Button Style="{StaticResource BotaoViewer3D}" Click="recarregar" ToolTip="Recarregar">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M12,7 A5,5 0 1 1 10.5,3.5 M11.5,1.5 L11.5,4.2 L8.8,4.2" />
                                </Button>

                                <ToggleButton x:Name="bt_planificado"
                                              Style="{StaticResource ToggleViewer3D}"
                                              Visibility="Collapsed"
                                              Click="alternar_planificado_click"
                                              ToolTip="Alternar entre peça dobrada 3D e chapa planificada">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M1.5,4 L12.5,4 L12.5,10 L1.5,10 Z M5.5,4 L5.5,10 M8.5,4 L8.5,10" />
                                        <TextBlock x:Name="txt_planificado" Text="Planificado" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>

                                <Button x:Name="bt_exportar_ifc" Style="{StaticResource BotaoViewer3D}" Click="exportar_ifc_click" ToolTip="Exportar modelo 3D para IFC">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M7,2 L7,9.5 M4,7 L7,10 L10,7 M2,12 L12,12" />
                                        <TextBlock Text="Exportar IFC" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="bt_exportar_dxf3d" Style="{StaticResource BotaoViewer3D}" Click="exportar_dxf3d_click" ToolTip="Exportar modelo 3D para DXF 3D (3DFACE)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M7,2 L7,9.5 M4,7 L7,10 L10,7 M2,12 L12,12" />
                                        <TextBlock Text="Exportar DXF 3D" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <ToggleButton x:Name="bt_medir_3d" Style="{StaticResource ToggleViewer3D}" Click="medir_click" ToolTip="Medir / Cotar distância entre 2 pontos (ESC limpa/cancela)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                              Stroke="#EF4444" StrokeThickness="1.6"
                                              Data="M2,11 L11,2 M2,11 L5,11 M2,11 L2,8 M11,2 L8,2 M11,2 L11,5" />
                                        <TextBlock Text="Medir" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>

                                <Button x:Name="bt_layers_3d" Style="{StaticResource BotaoViewer3D}" Click="layers_click" ToolTip="Mostrar / ocultar elementos agrupados por tipo">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                              Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M7,1.5 L12.5,4.5 L7,7.5 L1.5,4.5 Z M1.5,7.5 L7,10.5 L12.5,7.5 M1.5,10.5 L7,13.5 L12.5,10.5" />
                                        <TextBlock Text="Layers" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <CheckBox x:Name="chk_ucs_3d"
                                          Content="UCS"
                                          IsChecked="True"
                                          Checked="chk_ucs_3d_Changed"
                                          Unchecked="chk_ucs_3d_Changed"
                                          Foreground="#FFFFFF"
                                          FontSize="10.5"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"
                                          Margin="6,0,4,0"
                                          ToolTip="Mostrar / ocultar UCS Icon 3D" />
                            </WrapPanel>
                        </Expander>
                    </Border>

                    <Image Grid.Row="10"
						   Source="{Binding CAM.Imagem}"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Top"
						   Height="64"
						   Width="64"
						   Margin="5,30,0,0" />
                </Grid>
            </Grid>
            <Grid x:Name="grid_vista_2d" Background="Transparent" Visibility="Collapsed">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Visualizador 2D técnico rico para CAMs (fora de escala, estilo Purlin/Banzo/Arremate) -->
                    <Grid x:Name="grid_cam_2d_visual" Grid.Row="0" Visibility="Collapsed" Background="#FFFFFF">
                        <Canvas x:Name="canvas_cam_2d"
                                Background="#FFFFFF"
                                ClipToBounds="True"
                                SizeChanged="canvas_cam_2d_SizeChanged" />
                        <Button x:Name="bt_tela_cheia_cam2d" Style="{StaticResource BotaoViewer3D}" Click="abrir_tela_cheia_click" ToolTip="Abrir em janela maximizada" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,2 L12,2 L12,12 L2,12 Z M2,4.5 L12,4.5" />
                        </Button>
                    </Grid>

                    <!-- Visualizador 2D Helix para DXF / DWG (com suporte a Layouts e MViews) -->
                    <Grid x:Name="grid_dxf_2d_helix" Grid.Row="0">
                        <h:HelixViewport3D SizeChanged="viewport_SizeChanged"
										   Background="Black"
										   ZoomExtentsWhenLoaded="True"
										   Name="viewPort2D"
										   ShowCoordinateSystem="False"
										   IsHeadLightEnabled="True"
										   ZoomAroundMouseDownPoint="True"
										   RotateAroundMouseDownPoint="True"
										   CameraRotationMode="Turntable">
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <AmbientLight Color="Black" />
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </h:HelixViewport3D>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,8"
                                Padding="4,2"
                                CornerRadius="4"
                                Background="#D9111827"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <Expander x:Name="exp_ferramentas_2d"
                                      IsExpanded="True"
                                      Foreground="#FFFFFF"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                                <Expander.Header>
                                    <TextBlock Text="Ferramentas" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Expander.Header>
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <Button x:Name="bt_tela_cheia_2d"
                                            Style="{StaticResource BotaoViewer3D}"
                                            Click="abrir_tela_cheia_click"
                                            ToolTip="Abrir em janela maximizada">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M2,2 L12,2 L12,12 L2,12 Z M2,4.5 L12,4.5" />
                                    </Button>
                                    <Button Style="{StaticResource BotaoViewer3D}" Click="zom_ex" ToolTip="Enquadrar (Zoom Extents)">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M2,5 L2,2 L5,2 M9,2 L12,2 L12,5 M12,9 L12,12 L9,12 M5,12 L2,12 L2,9" />
                                    </Button>
                                    <Button x:Name="bt_abrir_externamente"
                                            Style="{StaticResource BotaoViewer3D}"
                                            Click="abrir_externamente_click"
                                            ToolTip="Abrir externamente">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M9,2 L13,2 L13,6 M13,2 L7,8 M6,3 L3,3 C2.4,3 2,3.4 2,4 L2,12 C2,12.6 2.4,13 3,13 L11,13 C11.6,13 12,12.6 12,12 L12,9" />
                                    </Button>
                                    <Button x:Name="bt_exportar_dxf"
                                            Style="{StaticResource BotaoViewer3D}"
                                            Click="exportar_dxf_click"
                                            ToolTip="Exportar arquivo DXF">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                                  Data="M3,1.5 L9,1.5 L12,4.5 L12,12.5 L3,12.5 Z M9,1.5 L9,4.5 L12,4.5" />
                                            <TextBlock Text="Exportar" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="bt_layers_2d" Style="{StaticResource BotaoViewer3D}" Click="layers_click" ToolTip="Mostrar / ocultar layers">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                                  Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                  Data="M7,1.5 L12.5,4.5 L7,7.5 L1.5,4.5 Z M1.5,7.5 L7,10.5 L12.5,7.5 M1.5,10.5 L7,13.5 L12.5,10.5" />
                                            <TextBlock Text="Layers" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton x:Name="bt_medir_2d"
                                                  Style="{StaticResource ToggleViewer3D}"
                                                  Click="medir_click"
                                                  ToolTip="Medir / Cotar distância entre 2 pontos (ESC limpa/cancela)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                                  Stroke="#EF4444" StrokeThickness="1.6"
                                                  Data="M2,11 L11,2 M2,11 L5,11 M2,11 L2,8 M11,2 L8,2 M11,2 L11,5" />
                                            <TextBlock Text="Medir" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </WrapPanel>
                            </Expander>
                        </Border>
                    </Grid>

                    <!-- Barra de abas de Layouts estilo AutoCAD (Model / A2 / PaperSpace) -->
                    <Border x:Name="bd_layouts_dxf"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="#1A202C"
                            BorderBrush="#334155"
                            BorderThickness="0,1,0,0"
                            Padding="6,0,6,2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="painel_layouts_dxf" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <!-- Canvas Overlay para marcador visual de Snap e preview pontilhado da cota -->
        <Canvas x:Name="canvas_snap_overlay" IsHitTestVisible="False" ClipToBounds="True">
            <Line x:Name="linha_preview_cota"
                  Visibility="Collapsed"
                  Stroke="#EF4444"
                  StrokeThickness="1.8"
                  StrokeDashArray="4 3" />
            <Border x:Name="tag_preview_cota"
                    Visibility="Collapsed"
                    Background="#E6DC2626"
                    CornerRadius="3"
                    Padding="5,1">
                <TextBlock x:Name="txt_preview_cota" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
            <Path x:Name="marcador_snap"
                  Visibility="Collapsed"
                  StrokeThickness="2"
                  Width="14" Height="14"
                  Stretch="Fill"/>
            <Border x:Name="tag_snap"
                    Visibility="Collapsed"
                    Background="#E60F172A"
                    BorderBrush="#38BDF8"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="4,1">
                <TextBlock x:Name="txt_tag_snap" FontSize="10" FontWeight="Bold" Foreground="White"/>
            </Border>
        </Canvas>

        <!-- Banner flutuante compacto no topo da ferramenta Medir / Cotar -->
        <Border x:Name="bd_medir_status"
                Visibility="Collapsed"
                Background="#E6111827"
                BorderBrush="#DC2626"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="txt_medir_status"
                           Text=""
                           Foreground="#FFFFFF"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ck_snap_end" Style="{StaticResource ToggleViewer3D}" IsChecked="True" Click="snap_toggle_click" ToolTip="Snap Ponto Final (Endpoint)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0" Stroke="#22C55E" StrokeThickness="1.7" Data="M2,2 L10,2 L10,10 L2,10 Z" />
                            <TextBlock Text="End" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ck_snap_mid" Style="{StaticResource ToggleViewer3D}" IsChecked="True" Click="snap_toggle_click" ToolTip="Snap Ponto Médio (Midpoint)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0" Stroke="#06B6D4" StrokeThickness="1.7" Data="M6,1.5 L11,10.5 L1,10.5 Z" />
                            <TextBlock Text="Mid" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ck_snap_near" Style="{StaticResource ToggleViewer3D}" IsChecked="False" Click="snap_toggle_click" ToolTip="Snap Mais Próximo (Nearest)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0" Stroke="#EAB308" StrokeThickness="1.7" Data="M2,2 L10,2 L2,10 L10,10 Z" />
                            <TextBlock Text="Near" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ck_ortho" Style="{StaticResource ToggleViewer3D}" IsChecked="False" Click="ortho_toggle_click" ToolTip="Ortho (L): Travar cota em ângulos retos a partir do 1º ponto">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0" Stroke="White" StrokeThickness="1.8" Data="M2,2 L2,10 L10,10" />
                            <TextBlock Text="L" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource BotaoViewer3D}" Click="limpar_medir_click" ToolTip="Fechar medição e limpar todas as cotas (ESC)">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="#FCA5A5" StrokeThickness="1.8" Data="M2,2 L10,10 M10,2 L2,10" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Overlay unificado de carregamento (IFC, DWG, DXF, CAM) com progresso e cancelar -->
        <Border x:Name="bd_progresso_ifc"
                Visibility="Collapsed"
                Background="#F5FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Width="340"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="lbl_progresso_ifc"
                               Text="Carregando..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="lbl_pct_ifc"
                               DockPanel.Dock="Right"
                               Text=""
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#1D4ED8"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar x:Name="pb_progresso_ifc"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,8" />
                <Button x:Name="bt_cancelar_ifc"
                        Style="{DynamicResource BotaoPerigo}"
                        Content="Cancelar"
                        HorizontalAlignment="Right"
                        Padding="12,3"
                        FontSize="11"
                        Click="cancelar_ifc_click" />
            </StackPanel>
        </Border>

        <!-- Barra unificada 3D / 2D no mesmo padrão dos ícones do visualizador 3D -->
        <Border x:Name="bd_seletor_modo"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,8,8"
                Padding="3"
                CornerRadius="4"
                Background="#B8111827"
                BorderBrush="#334155"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="bt_modo_3d"
                              Style="{StaticResource ToggleViewer3D}"
                              IsChecked="True"
                              Click="bt_modo_3d_Click"
                              ToolTip="Visualização 3D">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round"
                              Data="M7,1.5 L12.5,4.5 L12.5,10.5 L7,13.5 L1.5,10.5 L1.5,4.5 Z M1.5,4.5 L7,7.5 L12.5,4.5 M7,7.5 L7,13.5" />
                        <TextBlock Text="3D" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="bt_modo_2d"
                              Style="{StaticResource ToggleViewer3D}"
                              IsChecked="False"
                              Click="bt_modo_2d_Click"
                              ToolTip="Visualização Técnica 2D">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round"
                              Data="M1.5,2.5 L12.5,2.5 L12.5,11.5 L1.5,11.5 Z M4.5,5.5 L9.5,5.5 M4.5,8.5 L8,8.5" />
                        <TextBlock Text="2D" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>