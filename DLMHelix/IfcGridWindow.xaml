<Window x:Class="DLM.helix.IfcGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista e Gerenciamento de Eixos / Grid"
        Width="860"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#1E293B">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Opcoes gerais do Grid -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nome do Grid:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBox x:Name="txtNomeGrid" Width="150" Height="24" VerticalContentAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="Cota Z (mm):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBox x:Name="txtCotaZ" Width="80" Height="24" VerticalContentAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="chkVisivel" Content="Mostrar Grid no 3D" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="chkExportarIfc" Content="Exportar eixos (IfcGrid) junto com o IFC" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0369A1" />
            </WrapPanel>
        </Border>

        <!-- Listas de Eixos X e Y com Distancia entre Eixos -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Eixos X -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Eixos em X (ex: 1, 2, 3...)" FontWeight="Bold" Foreground="#1E293B" />
                        <TextBlock x:Name="txtTotalX" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11" />
                    </DockPanel>
                    <DataGrid x:Name="dgEixosX"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              CellEditEnding="DgEixos_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Ver" Binding="{Binding Visivel, UpdateSourceTrigger=PropertyChanged}" Width="38" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                            <DataGridTextColumn Header="Coord X (mm)" Binding="{Binding CoordenadaMm, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Distancia (mm)" Binding="{Binding DistanciaAnteriorTexto}" IsReadOnly="True" Width="95" />
                            <DataGridTemplateColumn Header="" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Click="BtnRemoverX_Click" Tag="{Binding}" Padding="4,1" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="+ Adicionar Eixo X" Click="BtnAddX_Click" Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <!-- Eixos Y -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Eixos em Y (ex: A, B, C...)" FontWeight="Bold" Foreground="#1E293B" />
                        <TextBlock x:Name="txtTotalY" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11" />
                    </DockPanel>
                    <DataGrid x:Name="dgEixosY"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              CellEditEnding="DgEixos_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Ver" Binding="{Binding Visivel, UpdateSourceTrigger=PropertyChanged}" Width="38" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                            <DataGridTextColumn Header="Coord Y (mm)" Binding="{Binding CoordenadaMm, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Distancia (mm)" Binding="{Binding DistanciaAnteriorTexto}" IsReadOnly="True" Width="95" />
                            <DataGridTemplateColumn Header="" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Click="BtnRemoverY_Click" Tag="{Binding}" Padding="4,1" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="+ Adicionar Eixo Y" Click="BtnAddY_Click" Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <!-- Rodape -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tol XY (mm):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#475569" FontWeight="SemiBold" />
                <TextBox x:Name="txtTolerancia" Width="56" Height="26" Text="500" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,8,0" ToolTip="Distancia minima entre eixos (nao cria 2 eixos se distancia &lt;= valor)" />
                <TextBlock Text="Tol Z (mm):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#475569" FontWeight="SemiBold" />
                <TextBox x:Name="txtToleranciaZ" Width="56" Height="26" Text="1000" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,8,0" ToolTip="Range Z em torno do zero (±valor/2, ex: 1000 = -500 a +500 mm)" />
                <Button Content="Remapear Eixos (Ler 3D)" Click="BtnRegerarPilares_Click" Padding="12,6" Background="#E0F2FE" BorderBrush="#0284C7" Foreground="#0369A1" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aplicar Grid" Click="BtnAplicar_Click" IsDefault="True" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="16,6" Margin="0,0,8,0" BorderThickness="0" />
                <Button Content="Cancelar" IsCancel="True" Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
